<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Crucify.Extract</AssemblyName>
    <RootNamespace>CrucifyExtract</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\crucify.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>Crucify</Company>
    <Product>Crucify.Extract</Product>
    <Description>Drag-and-drop add-on installer for WoW Forever</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.8" />
  </ItemGroup>

</Project>
