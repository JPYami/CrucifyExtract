<Window x:Class="CrucifyExtract.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crucify.Extract"
        Width="1010" Height="790" MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#07060A"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" UseLayoutRounding="True">

    <!-- ===== ambient background ===== -->
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.65,1">
        <GradientStop Color="#08060C" Offset="0" />
        <GradientStop Color="#0B0713" Offset="0.55" />
        <GradientStop Color="#120A18" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Ellipse Width="640" Height="440" HorizontalAlignment="Left" VerticalAlignment="Top"
             Margin="-240,-210,0,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#4AFF2E63" Offset="0" />
          <GradientStop Color="#00FF2E63" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <Ellipse Width="760" Height="540" HorizontalAlignment="Right" VerticalAlignment="Bottom"
             Margin="0,0,-280,-260" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#468B5CF6" Offset="0" />
          <GradientStop Color="#008B5CF6" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <Rectangle IsHitTestVisible="False" Opacity="0.045" ClipToBounds="True">
      <Rectangle.Fill>
        <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
          <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Transparent">
              <GeometryDrawing.Pen>
                <Pen Brush="#FFFFFF" Thickness="1" />
              </GeometryDrawing.Pen>
              <GeometryDrawing.Geometry>
                <GeometryGroup>
                  <LineGeometry StartPoint="0,28" EndPoint="28,28" />
                  <LineGeometry StartPoint="28,0" EndPoint="28,28" />
                </GeometryGroup>
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- top accent line -->
    <Border Height="2" VerticalAlignment="Top" Margin="60,0,60,0" CornerRadius="1" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#00FF2E63" Offset="0" />
          <GradientStop Color="#CCFF2E63" Offset="0.35" />
          <GradientStop Color="#CCB028FF" Offset="0.65" />
          <GradientStop Color="#00B028FF" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect Color="#FF2E63" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />
      </Border.Effect>
    </Border>

    <!-- ===== content ===== -->
    <Grid Margin="26,16,26,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- header -->
      <Grid Grid.Row="0" Height="50" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="LogoMark" Width="36" Height="36" CornerRadius="11" VerticalAlignment="Center"
                Background="{StaticResource AccentGradient}">
          <Border.Effect>
            <DropShadowEffect x:Name="LogoGlow" Color="#FF2E63" BlurRadius="22" ShadowDepth="0" Opacity="0.6" />
          </Border.Effect>
          <Grid>
            <Rectangle Width="4" Height="19" RadiusX="2" RadiusY="2" Fill="#FFFFFF" />
            <Rectangle Width="19" Height="4" RadiusX="2" RadiusY="2" Fill="#FFFFFF" Margin="0,0,0,3" />
          </Grid>
          <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="Opacity"
                                   From="0.35" To="0.9" Duration="0:0:2.4" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Border.Triggers>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Crucify" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="." FontSize="17" FontWeight="Bold" Foreground="{StaticResource Crimson}" />
            <TextBlock Text="Extract" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
          </StackPanel>
          <TextBlock Text="ADD-ON INSTALLER  &#183;  WOW FOREVER" FontSize="9" FontWeight="SemiBold"
                     Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="AdminBadge" CornerRadius="6" Background="#2A1A12" BorderBrush="#5A3A1E"
                  BorderThickness="1" Padding="7,3" Margin="0,0,10,0" Visibility="Collapsed"
                  VerticalAlignment="Center">
            <TextBlock Text="ADMIN" FontSize="8.5" FontWeight="Bold" Foreground="#FBBF24" />
          </Border>
          <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
            <Path Data="M0,0 L11,0" Stroke="#C9C3DC" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Close">
            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#C9C3DC" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- game client card -->
      <Border x:Name="GameCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="15,13">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Width="42" Height="42" CornerRadius="11" Background="#191323" BorderBrush="#2A2138"
                  BorderThickness="1" VerticalAlignment="Center">
            <Path Data="M3,6 L8,6 L10,9 L19,9 L19,18 L3,18 Z" Stroke="#B28BFF" StrokeThickness="1.5"
                  StrokeLineJoin="Round" Stretch="Uniform" Width="20" Height="18"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="1" Margin="13,0,14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="GAME CLIENT" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <Border x:Name="StatusPill" CornerRadius="8" Padding="7,2.5" Margin="10,0,0,0" Background="#14261D">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="StatusDot" Width="5.5" Height="5.5" Fill="#34D399" VerticalAlignment="Center" />
                  <TextBlock x:Name="StatusPillText" Text="Detected" FontSize="9" FontWeight="Bold"
                             Foreground="#34D399" Margin="5,0,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock x:Name="GamePathText" Text="Scanning for WoW Forever&#8230;" FontSize="13"
                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <TextBlock x:Name="TargetText" Text="Interface\AddOns" FontSize="10" FontFamily="Consolas, Segoe UI"
                       Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RescanButton" Style="{StaticResource GhostButton}" Content="Rescan"
                    Click="Rescan_Click" Margin="0,0,8,0" />
            <Button x:Name="BrowseButton" Style="{StaticResource GhostButton}" Content="Browse"
                    Click="Browse_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- drop zone -->
      <Border x:Name="DropZone" Grid.Row="2" Margin="0,14,0,0" CornerRadius="16" Background="#0A0810"
              BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
              AllowDrop="True" Cursor="Hand"
              DragEnter="DropZone_DragEnter"
              DragOver="DropZone_DragOver"
              DragLeave="DropZone_DragLeave"
              Drop="DropZone_Drop"
              MouseLeftButtonUp="DropZone_Click">
        <Border.Effect>
          <DropShadowEffect x:Name="DropGlow" Color="#FF2E63" BlurRadius="0" ShadowDepth="0" Opacity="0" />
        </Border.Effect>

        <Grid>
          <Rectangle x:Name="DashRing" RadiusX="15" RadiusY="15" Stroke="#382E4C" StrokeThickness="1.3"
                     StrokeDashArray="3 3" Margin="1" IsHitTestVisible="False">
            <Rectangle.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="12"
                                     Duration="0:0:1.6" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Rectangle.Triggers>
          </Rectangle>

          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
            <Grid Width="56" Height="56" HorizontalAlignment="Center">
              <Border CornerRadius="16" Background="#181223" BorderBrush="#2A2138" BorderThickness="1">
                <Path Data="M8,20 L8,23.5 C8,25 9,26 10.5,26 L25.5,26 C27,26 28,25 28,23.5 L28,20 M18,7 L18,18.5 M12.5,14 L18,19.5 L23.5,14"
                      Stroke="#FF2E63" StrokeThickness="2.2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="36" Height="34" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>

            <TextBlock Text="Drop your archives here" FontSize="19" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,15,0,0" />
            <TextBlock x:Name="DropSubtext" Text="RAR  &#183;  ZIP  &#183;  7Z  &#183;  TAR  &#183;  GZ      or click to browse"
                       FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                       Margin="0,7,0,0" />
            <TextBlock Text="Multiple archives and folders welcome" FontSize="10"
                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- queue -->
      <Grid Grid.Row="3" Margin="0,16,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="3,0,3,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="QUEUE" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock x:Name="QueueCountText" Text="0 items" FontSize="9.5"
                       Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="ClearButton" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                  Content="Clear all" Click="Clear_Click" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="#0A0811">
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="9,9,5,9" Focusable="False">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource RowBg}" BorderBrush="{StaticResource RowBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,7" Opacity="0">
                      <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                               Duration="0:0:0.22" />
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Border.Triggers>

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="34" Height="34" CornerRadius="9" Background="#171122"
                                BorderBrush="#241D33" BorderThickness="1" VerticalAlignment="Center">
                          <Path Data="M3,8 L10,4 L17,8 L17,18 L10,22 L3,18 Z M10,4 L10,13 M3,8 L10,13 L17,8"
                                Stroke="#9A86C8" StrokeThickness="1.35" StrokeLineJoin="Round"
                                Stretch="Uniform" Width="17" Height="17"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource TextMuted}"
                                     TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Width="164" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                     Foreground="{Binding StatusBrush}" HorizontalAlignment="Right"
                                     TextTrimming="CharacterEllipsis" />
                          <ProgressBar Height="4" Margin="0,7,0,0" Maximum="1"
                                       Style="{StaticResource SlimProgress}"
                                       Value="{Binding Progress, Mode=OneWay}"
                                       Visibility="{Binding BarVisibility}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Nothing queued yet  &#183;  drop an archive above to get started"
                       FontSize="11" Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
      </Grid>

      <!-- overall progress -->
      <Grid x:Name="ProgressStrip" Grid.Row="4" Margin="3,14,3,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ProgressBar x:Name="OverallBar" Style="{StaticResource SlimProgress}" Height="5"
                     Maximum="1" VerticalAlignment="Center" />
        <TextBlock x:Name="OverallText" Grid.Column="1" Text="0%" FontSize="10"
                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>

      <!-- actions -->
      <Grid Grid.Row="5" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="OverwriteToggle" Style="{StaticResource Toggle}" IsChecked="True"
                    VerticalAlignment="Center">
            <TextBlock Text="Replace existing add-ons" FontSize="11"
                       Foreground="{StaticResource TextSecondary}" />
          </CheckBox>
          <Button x:Name="OpenAddonsButton" Style="{StaticResource LinkButton}" Margin="20,0,0,0"
                  Content="Open AddOns folder" Click="OpenAddons_Click" VerticalAlignment="Center" />
        </StackPanel>

        <Button x:Name="InstallButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                Width="216" Content="INSTALL ADD-ONS" Click="Install_Click" />
      </Grid>

      <!-- footer -->
      <Grid Grid.Row="6" Margin="3,12,3,0">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="FooterDot" Width="6" Height="6" Fill="#34D399" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusMessage" Text="Ready." FontSize="10" Foreground="{StaticResource TextMuted}"
                     Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock HorizontalAlignment="Right" Text="v1.0.0" FontSize="9.5" Foreground="#4B4560"
                   VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Grid>
</Window>
